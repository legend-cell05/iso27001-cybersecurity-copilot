# ---------------------------------------------------------------------------
# iso27001-cybersecurity-copilot -- example configuration
#
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Nothing below is a real
# credential: these are local placeholders.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
# Holds the organisation, its assets, the risk register, the applicability
# decisions, the evidence index and every assessment ever run.
SENTINEL_DB_HOST=localhost
SENTINEL_DB_PORT=5432
SENTINEL_DB_NAME=sentinel
SENTINEL_DB_USER=sentinel_app
SENTINEL_DB_PASSWORD=change_me_local_only

SENTINEL_SCHEMA=isms

# --- The organisation being assessed ---------------------------------------
# A name that appears on the Statement of Applicability and the audit dossier.
SENTINEL_ORGANISATION=Meridian Logistics SAS
# The ISMS scope statement. Certification is granted against a scope, not
# against a company, so this belongs in every export.
SENTINEL_SCOPE=The information systems supporting freight booking and customer data processing, at the Lyon and Lille sites.

# --- Risk method -----------------------------------------------------------
# Likelihood and impact are scored 1-5; inherent risk is their product, so the
# scale runs 1-25. These two numbers are the organisation's risk appetite and
# they are configuration because they are a business decision, not a constant.
#
# At or below this, a residual risk needs no further treatment.
SENTINEL_RISK_APPETITE=6
# Above this, a residual risk cannot simply be accepted: the gate treats an
# acceptance at this level as a blocking finding unless top management has
# signed it off, which is recorded on the acceptance itself.
SENTINEL_RISK_ESCALATION=15

# --- Evidence freshness ----------------------------------------------------
# How old a piece of evidence may be before it stops supporting its control.
# The default is a year, because that is the certification cycle; controls
# whose evidence ages faster override it in the catalogue.
SENTINEL_EVIDENCE_MAX_AGE_DAYS=365
# Evidence within this many days of expiring is reported as a warning, so an
# audit is not the moment the organisation discovers its logs are stale.
SENTINEL_EVIDENCE_WARN_DAYS=60

# --- The readiness gate ----------------------------------------------------
# A certification audit is not something to walk into hopefully. The gate
# refuses (exit code 3) while any blocking finding stands. These thresholds
# decide what "blocking" means.
#
# The share of applicable controls that must be implemented.
SENTINEL_MIN_IMPLEMENTED_RATIO=0.95
# Applicable controls with no evidence at all that the gate will tolerate.
SENTINEL_MAX_CONTROLS_WITHOUT_EVIDENCE=0
# Whether an internal audit and a management review are required before the
# gate can pass. Clause 9 requires both; this exists so the gate can be run
# earlier in the programme without pretending they happened.
SENTINEL_REQUIRE_INTERNAL_AUDIT=true

# --- Paths -----------------------------------------------------------------
SENTINEL_DATA_DIR=data
# Where the control catalogue lives. It is data, versioned with the code.
SENTINEL_CATALOGUE_DIR=catalogue

# --- Demo data -------------------------------------------------------------
# The generator is seeded, so the same seed produces the same organisation,
# the same risks and the same deliberate gaps.
SENTINEL_RANDOM_SEED=20260927

# --- Runtime ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
SENTINEL_LOG_LEVEL=INFO
# text | json
SENTINEL_LOG_FORMAT=text
